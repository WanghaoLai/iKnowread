FROM node:24-bookworm-slim@sha256:d6aa754f16b3197301076f047b5def2f02ea1dbbc2ca920407d46d7ec7f87b20 AS build
WORKDIR /src
COPY vue/package.json vue/package-lock.json ./
RUN npm ci
COPY vue/ ./
ENV VITE_BASE_URL=/api
ENV NODE_OPTIONS=--max-old-space-size=768
RUN npm run build

FROM golang:1.26.9-alpine3.23@sha256:6750308561953d451210ed1a8086d36c8c8bdcbf672d38d9d0d424b8a7a0216c AS caddy-build
WORKDIR /src
RUN go mod init iknowread/caddy-build \
    && go get github.com/caddyserver/caddy/v2/cmd/caddy@v2.11.7 \
    && go get golang.org/x/net@v0.60.0 \
    && CGO_ENABLED=0 go build -trimpath \
        -ldflags="-s -w -X github.com/caddyserver/caddy/v2.CustomVersion=v2.11.7" \
        -o /out/caddy github.com/caddyserver/caddy/v2/cmd/caddy

FROM alpine:3.23@sha256:85fe1e81d6758c208f3e1eed4338a1997e19d4be002d4dd32d3100c9a8c010a0
RUN apk upgrade --no-cache zlib \
    && apk add --no-cache ca-certificates mailcap tzdata \
    && addgroup -S -g 10002 caddy \
    && adduser -S -D -H -u 10002 -G caddy caddy \
    && install -d -o caddy -g caddy -m 0750 /data /config /srv
ENV XDG_CONFIG_HOME=/config \
    XDG_DATA_HOME=/data \
    HOME=/config
COPY --from=caddy-build /out/caddy /usr/bin/caddy
COPY --from=build --chown=caddy:caddy /src/dist /srv
COPY deploy/Caddyfile /etc/caddy/Caddyfile
USER 10002:10002
EXPOSE 80 443
CMD ["caddy", "run", "--config", "/etc/caddy/Caddyfile", "--adapter", "caddyfile"]
