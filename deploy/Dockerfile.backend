FROM python:3.12-slim-bookworm@sha256:34386ef0cb081344d7ec1c103ba398e6e9f64e9ab3a1509accc92a4e24a07258
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    HOME=/tmp
WORKDIR /app
# Bump this reviewed epoch when Debian publishes a security fix that must
# invalidate BuildKit's cached apt upgrade layer on developer and server hosts.
ARG DEBIAN_SECURITY_REFRESH=2026-10-26
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt/lists,sharing=locked \
    set -eux; \
    echo "Debian security refresh: ${DEBIAN_SECURITY_REFRESH}"; \
    rm -f /etc/apt/apt.conf.d/docker-clean; \
    sed -i 's|http://deb.debian.org|https://deb.debian.org|g' /etc/apt/sources.list.d/debian.sources; \
    for attempt in 1 2 3 4 5; do \
        if apt-get -o APT::Update::Error-Mode=any \
            -o Acquire::Retries=5 -o Acquire::https::Timeout=30 update; then \
            break; \
        fi; \
        if [ "$attempt" = 5 ]; then exit 1; fi; \
        sleep "$((attempt * 2))"; \
    done; \
    for attempt in 1 2 3 4 5; do \
        if DEBIAN_FRONTEND=noninteractive \
            apt-get -o Acquire::Retries=5 -o Acquire::https::Timeout=30 upgrade -y \
            && DEBIAN_FRONTEND=noninteractive \
            apt-get -o Acquire::Retries=5 -o Acquire::https::Timeout=30 install -y --no-install-recommends \
                tesseract-ocr tesseract-ocr-eng tesseract-ocr-chi-sim \
                fonts-noto-core fonts-noto-cjk ca-certificates; then \
            break; \
        fi; \
        if [ "$attempt" = 5 ]; then exit 1; fi; \
        sleep "$((attempt * 2))"; \
    done; \
    apt-get clean
COPY fastapi-app/requirements.lock ./requirements.lock
RUN --mount=type=cache,target=/root/.cache/pip,sharing=locked \
    pip install -r requirements.lock
RUN ocrmypdf --version \
    && tesseract --list-langs | grep -Fx eng \
    && tesseract --list-langs | grep -Fx chi_sim
RUN groupadd --gid 10001 app && useradd --uid 10001 --gid app --create-home app \
    && mkdir -p /app/data && chown app:app /app/data
COPY --chown=app:app fastapi-app/app ./app
COPY --chown=app:app fastapi-app/main.py ./main.py
COPY --chown=app:app fastapi-app/scripts/init_app_data.py ./scripts/init_app_data.py
USER app
EXPOSE 9090
CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "9090", "--workers", "1", "--proxy-headers", "--no-access-log"]
