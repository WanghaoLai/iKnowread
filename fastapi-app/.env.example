# iKnowread 后端配置模板 —— 部署时复制为 .env 并按环境修改，代码零改动

# ---- 服务 ----
APP_NAME=iKnowread
HOST=0.0.0.0
PORT=9090
# true 开启热重载（仅开发）；生产必须 false
DEBUG=false

# ---- 认证与密钥 ----
# 会话令牌签名密钥：生产必填（openssl rand -hex 32 生成）；留空时开发环境自动生成仅本次进程有效的密钥
AUTH_SECRET=
# AI 配置的 Fernet 加密密钥；留空时自动生成并保存到 data/.ai-config-key
# 生成：python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AI_CONFIG_KEY=
# 初始管理员：密码留空则首次启动生成随机一次性密码（打印并写入 data/.initial-admin-password，首次登录后自动删除）
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=
# 公网生产建议关闭自助注册，由管理员创建账号
ALLOW_REGISTRATION=false
# 认证防滥用：时间窗（秒）、单 IP 登录/注册次数、密码计算并发
AUTH_RATE_WINDOW_SECONDS=60
LOGIN_RATE_LIMIT=10
REGISTER_RATE_LIMIT=3
PASSWORD_WORKERS=2
PASSWORD_QUEUE_WAIT_SECONDS=1

# ---- MySQL 数据库 ----
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=change-me
DB_DATABASE=iknowread
# 启动时自动创建数据库并执行版本化迁移（app/migrations/），全新环境零手工 SQL
DB_AUTO_CREATE=true
# 打印 SQL 日志（排查用）
DB_ECHO=false

# ---- 文件存储 ----
# 留空 = fastapi-app/data/files；生产建议绝对路径（如 /var/data/iknowread）以便挂载持久卷
UPLOAD_DIR=
# 每账号累计文档容量、文档数量，以及服务器必须保留的空闲空间（字节）
USER_STORAGE_QUOTA_BYTES=2147483648
USER_DOCUMENT_LIMIT=200
STORAGE_MIN_FREE_BYTES=2147483648
# 文档与头像上传在 multipart 解析前共享的并发槽；小型服务器保持保守值
UPLOAD_CONCURRENCY=3
UPLOAD_QUEUE_WAIT_SECONDS=1
# 文档解析边界
DOCX_MAX_ENTRIES=2000
DOCX_MAX_UNCOMPRESSED_BYTES=209715200
PDF_MAX_PAGES=1000

# ---- 扫描版 PDF OCR ----
# 首发默认关闭；明确完成资源验收后才改为 true
OCR_ENABLED=false
# OCRmyPDF 可执行文件名或绝对路径
OCR_COMMAND=ocrmypdf
# Tesseract 语言包；中文环境需安装 chi_sim，英文使用 eng
OCR_LANGUAGES=chi_sim+eng
# 同时处理的文档数，以及单个文档内部并发数；小型服务器建议均为 1
OCR_WORKERS=1
OCR_JOBS_PER_DOCUMENT=1
# 单份文档总超时、单页识别超时（秒）
OCR_TIMEOUT_SECONDS=900
OCR_PAGE_TIMEOUT_SECONDS=120
# 单页图像像素上限（百万像素），防止异常 PDF 耗尽内存
OCR_MAX_IMAGE_MPIXELS=50

# ---- AI 并发 ----
AI_GLOBAL_CONCURRENCY=3
AI_ACCOUNT_CONCURRENCY=1
AI_QUEUE_WAIT_SECONDS=1
AI_MAX_RESPONSE_BYTES=2097152

# ---- 笔记导出 ----
NOTE_EXPORT_MAX_ITEMS=5000
NOTE_EXPORT_MAX_BYTES=20971520

# ---- 跨域 ----
# 多个源用逗号分隔；生产不允许使用 *（启动时校验会直接失败）
CORS_ORIGINS=http://localhost:5173
